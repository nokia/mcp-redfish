# Redfish MCP Server Configuration
# Copy this file to .env and modify the values as needed
# All configuration is validated on startup - see README.md for details

# Python path for the project
PYTHONPATH=src

# MCP Transport configuration
# Supported values: stdio, sse, streamable-http
# stdio is unchanged. HTTP transports fail closed unless MCP_AUTH_MODE is set
# or MCP_HTTP_AUTH=false. Prefer streamable-http over sse. See docs/MCP_AUTH.md
# for authentication and docs/MCP_HTTP_DEPLOYMENT.md for listener security.
MCP_TRANSPORT=stdio

# --- MCP HTTP authentication (ignored on stdio) ---
# Breaking change: HTTP MCP transports (sse, streamable-http) now require
# authentication. Set MCP_AUTH_MODE (and the matching MCP_AUTH_* variables),
# or set MCP_HTTP_AUTH=false to keep unauthenticated HTTP. stdio is unchanged.
#
# MCP_HTTP_AUTH=true (default)
# MCP_AUTH_MODE=none
# Non-loopback SSE is refused by default because it lacks Host/Origin checks.
# Legacy break-glass only; prefer streamable-http:
# MCP_ALLOW_REMOTE_SSE=false

# Lab only — any client that can reach this MCP Server can call MCP tools using
# the configured Redfish credentials:
# WARNING: MCP HTTP authentication is disabled (MCP_HTTP_AUTH=false). Any client that can reach this MCP Server can call MCP tools using the configured Redfish credentials. Listening on FASTMCP_HOST=<addr> port <port>.
# MCP_HTTP_AUTH=false

# Primary HTTP example: JWT with JWKS (issuer and audience are required)
# MCP_AUTH_MODE=token
# MCP_AUTH_TOKEN_TYPE=jwt
# MCP_AUTH_JWT_JWKS_URI=https://idp.example.com/.well-known/jwks.json
# MCP_AUTH_JWT_ISSUER=https://idp.example.com/
# MCP_AUTH_JWT_AUDIENCE=mcp-redfish
# MCP_AUTH_JWT_ALGORITHM=RS256
# MCP_AUTH_REQUIRED_SCOPES=["mcp:read"]
# MCP_AUTH_TOKEN_LEEWAY_SECONDS=60

# JWT public key instead of JWKS (PEM). Do not put a private key here.
# MCP_AUTH_JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"

# Introspection (RFC 7662) instead of JWT
# MCP_AUTH_TOKEN_TYPE=introspection
# MCP_AUTH_INTROSPECTION_URL=https://idp.example.com/oauth/introspect
# MCP_AUTH_INTROSPECTION_CLIENT_ID=mcp-redfish
# MCP_AUTH_INTROSPECTION_CLIENT_SECRET=replace-me
# MCP_AUTH_INTROSPECTION_AUTH_METHOD=client_secret_basic
# MCP_AUTH_INTROSPECTION_ISSUER=https://idp.example.com/
# MCP_AUTH_INTROSPECTION_AUDIENCE=mcp-redfish
# MCP_AUTH_INTROSPECTION_ALLOWED_TOKEN_TYPES=["Bearer","access_token"]
# Private/internal IdPs require explicit trust in internal DNS/routing:
# MCP_AUTH_INTROSPECTION_ALLOW_PRIVATE=false

# Remote OAuth (IdP with Dynamic Client Registration)
# MCP_AUTH_MODE=remote_oauth
# MCP_AUTH_AUTHORIZATION_SERVERS=["https://idp.example.com"]
# MCP_AUTH_BASE_URL=https://mcp.example.com
# Plus the JWT or introspection variables above.

# OAuth Proxy (fixed app registration; no DCR). Off-loopback requires a signing key.
# MCP_AUTH_MODE=oauth_proxy
# MCP_AUTH_UPSTREAM_AUTHORIZATION_ENDPOINT=https://idp.example.com/oauth/authorize
# MCP_AUTH_UPSTREAM_TOKEN_ENDPOINT=https://idp.example.com/oauth/token
# MCP_AUTH_CLIENT_ID=registered-app-id
# MCP_AUTH_CLIENT_SECRET=replace-me
# MCP_AUTH_BASE_URL=https://mcp.example.com
# MCP_AUTH_JWT_SIGNING_KEY=replace-with-at-least-32-chars
# MCP_AUTH_REQUIRE_CONSENT=true
# MCP_AUTH_FORWARD_PKCE=true
# MCP_AUTH_ALLOWED_CLIENT_REDIRECT_URIS=["http://localhost:*","http://127.0.0.1:*"]
# Plus JWT or introspection variables for upstream access tokens.

# OIDC Proxy (discovery URL). Same consent/redirect/signing-key rules as OAuth Proxy.
# MCP_AUTH_MODE=oidc_proxy
# MCP_AUTH_OIDC_CONFIG_URL=https://idp.example.com/.well-known/openid-configuration
# MCP_AUTH_CLIENT_ID=registered-app-id
# MCP_AUTH_CLIENT_SECRET=replace-me
# MCP_AUTH_BASE_URL=https://mcp.example.com
# MCP_AUTH_JWT_SIGNING_KEY=replace-with-at-least-32-chars
# Required unless MCP_AUTH_OIDC_VERIFY_ID_TOKEN=true:
# MCP_AUTH_OIDC_AUDIENCE=https://mcp.example.com
# Loopback / private JWKS (lab IdPs such as local Dex). Default refuses private addresses.
# MCP_AUTH_JWKS_ALLOW_PRIVATE=false

# Multi-process proxy storage (encrypted Redis). Default is encrypted disk.
# MCP_AUTH_STORAGE_BACKEND=redis
# MCP_AUTH_REDIS_URL=rediss://redis.example:6379/0
# MCP_AUTH_STORAGE_ENCRYPTION_KEY=replace-with-a-fernet-key

# HTTP listener settings. See docs/MCP_HTTP_DEPLOYMENT.md.
# Unset/empty FASTMCP_HOST → this project binds 127.0.0.1.
# Kubernetes ClusterIP/Ingress: FASTMCP_HOST=0.0.0.0 (do not auto-detect).
# FASTMCP_HOST=127.0.0.1
# FASTMCP_PORT=8000
# Loopback defaults to auto. Non-loopback defaults to strict and requires exact
# client-facing names; pattern metacharacters (*, ?, [) are refused.
# FASTMCP_HTTP_ALLOWED_HOSTS=["mcp.example.com"]
# FASTMCP_HTTP_ALLOWED_ORIGINS=["https://app.example.com"]
# FASTMCP_HTTP_HOST_ORIGIN_PROTECTION=true

# In-process HTTPS (this MCP Server presents a cert). Both required if used.
# MCP_TLS_CERTFILE=/path/to/server.crt
# MCP_TLS_KEYFILE=/path/to/server.key

# Assert TLS (or equivalent) is terminated in front of this MCP Server.
# Does not enable TLS. Required for auth on a non-loopback bind without cert/key.
# MCP_TLS_TERMINATED=true

# These FastMCP-native patterns are refused at startup; see docs/MCP_AUTH.md.
#   FASTMCP_SERVER_AUTH / FASTMCP_SERVER_AUTH_*  (dual auth wiring)
#   FASTMCP_HTTP_ALLOWED_ORIGINS=["*"]           (*, ?, [ patterns are refused)
#   FASTMCP_HTTP_ALLOWED_HOSTS=["*.*"]            (*, ?, [ patterns are refused)

# Enterprise proxy: the default already routes provider fetches through
# HTTPS_PROXY while keeping FastMCP's address blocklist. Set the variable below
# only if this host cannot resolve the provider name, or if the proxy rejects
# CONNECT to an IP literal. It requires HTTPS_PROXY or ALL_PROXY to be set.
# FASTMCP_SSRF_TRUST_PROXY=true


# Redfish API endpoints configuration
# JSON array of endpoint objects - each endpoint must have an "address" field
# Additional fields per endpoint: port, username, password, auth_method, tls_server_ca_cert, tls_verify
# Example with multiple endpoints:
# REDFISH_HOSTS=[{"address": "192.168.1.100", "username": "admin1", "password": "secret1"}, {"address": "192.168.1.101", "port": 8443}]
REDFISH_HOSTS=[{"address": "192.168.1.100"}]

# Default Redfish API port
REDFISH_PORT=443

# Authentication method
# Supported values: basic, session
REDFISH_AUTH_METHOD=session

# Redfish credentials
REDFISH_USERNAME=admin
REDFISH_PASSWORD=your_password_here

# TLS Server CA certificate path (optional)
# REDFISH_SERVER_CA_CERT=/path/to/ca-cert.pem

# Verify Redfish server TLS certificates
# Set to false only when explicitly accepting unauthenticated TLS.
REDFISH_TLS_VERIFY=true

# SSDP Discovery settings (optional)
# Enable discovery of Redfish endpoint candidates via SSDP.
# Discovered endpoints must be reviewed and added to REDFISH_HOSTS before use.
REDFISH_DISCOVERY_ENABLED=false

# Interval for SSDP discovery in seconds
REDFISH_DISCOVERY_INTERVAL=30

# Logging configuration
# Log levels: DEBUG, INFO, WARNING, ERROR, CRITICAL
MCP_REDFISH_LOG_LEVEL=INFO

# Retry configuration for Redfish operations
# Maximum number of retry attempts for failed requests
REDFISH_MAX_RETRIES=3

# Initial delay between retries in seconds
REDFISH_INITIAL_DELAY=1.0

# Maximum delay between retries in seconds
REDFISH_MAX_DELAY=60.0

# Backoff factor for exponential backoff (each retry delay = previous_delay * factor)
REDFISH_BACKOFF_FACTOR=2.0

# Enable jitter to avoid thundering herd problems (true/false)
REDFISH_JITTER=true
